def calculate_metrics(y_test, y_pred, y_proba, n_classes):
    """
    Calculates classification performance metrics including Average Accuracy (AvAcc),
    Geometric Mean (G-Mean), and Macro Area Under the ROC Curve (MAUC).

    Parameters:
    -----------
    y_test : array-like
        Actual true labels of the test dataset.
    y_pred : array-like
        Predicted labels generated by the ensemble model.
    y_proba : array-like
        Predicted class probabilities for each sample.
    n_classes : int
        Number of unique classes in the dataset.

    Returns:
    --------
    tuple (float, float, float)
        Calculated metrics values in the order of (AvAcc, G-Mean, MAUC).
    """
    cm = confusion_matrix(y_test, y_pred, labels=np.arange(n_classes))
    with np.errstate(divide='ignore', invalid='ignore'):
        recall_per_class = np.diag(cm) / np.sum(cm, axis=1)
        recall_per_class = np.nan_to_num(recall_per_class, nan=0.0)
        
    avacc = np.mean(recall_per_class)
    gmean = np.prod(recall_per_class)**(1/n_classes) if np.all(recall_per_class > 0) else 0.0
    
    try:
        mauc = roc_auc_score(pd.get_dummies(y_test), y_proba, average='macro', multi_class='ovr')
    except:
        mauc = 0.0
        
    return avacc, gmean, mauc


def get_major_minor_classes(y):
    """
    Categorizes classes into majority and minority groups based on the 
    average threshold of class frequencies.

    Parameters:
    -----------
    y : array-like
        Array of class labels from the training dataset.

    Returns:
    --------
    tuple (list, list)
        A list of majority class labels and a list of minority class labels.
    """
    class_counts = Counter(y)
    max_count = max(class_counts.values())
    min_count = min(class_counts.values())
    threshold = (max_count + min_count) / 2
    
    majority = [cls for cls, count in class_counts.items() if count >= threshold]
    minority = [cls for cls in class_counts if cls not in majority]
    return majority, minority


def custom_bootstrap(X, y, majority, minority):
    """
    Performs a custom bootstrap sampling technique to balance representation size 
    between majority classes (with replacement) and minority classes (without 
    replacement up to a dynamically chosen random limit).

    Parameters:
    -----------
    X : numpy.ndarray
        Feature matrix of the training data.
    y : numpy.ndarray
        Class labels of the training data.
    majority : list
        List of labels categorized as majority classes.
    minority : list
        List of labels categorized as minority classes.

    Returns:
    --------
    tuple (numpy.ndarray, numpy.ndarray)
        Resampled feature matrix (X) and corresponding class labels (y).
    """
    class_counts = Counter(y)
    minority_counts = [class_counts[cls] for cls in minority]
    avg_minority = int(np.mean(minority_counts) if minority_counts else 0)
    
    class_indices = {cls: np.where(y == cls)[0] for cls in np.unique(y)}
    size = random.randint(2, max(2, avg_minority))
    
    indices = []
    for cls, idxs in class_indices.items():
        if cls in majority:
            sampled = np.random.choice(idxs, size=size, replace=True)
        else:
            max_sample = min(size, len(idxs))
            sampled = np.random.choice(idxs, size=max_sample, replace=False)
        indices.extend(sampled)
        
    np.random.shuffle(indices)
    return X[indices], y[indices]


def resampling_RUS(X, y):
    """
    Balances class distribution using Random Under Sampling (RUS) if the 
    macro Imbalance Ratio (IR) is greater than 1.

    Parameters:
    -----------
    X : numpy.ndarray
        Feature matrix.
    y : numpy.ndarray
        Class labels.

    Returns:
    --------
    tuple (numpy.ndarray, numpy.ndarray)
        Feature matrix and labels after applying under-sampling.
    """
    class_counts = Counter(y)
    max_count = max(class_counts.values())
    min_count = min(class_counts.values())
    ir = max_count / min_count if min_count > 0 else 0

    if ir > 1:
        sampler = RandomUnderSampler(random_state=None)
        return sampler.fit_resample(X, y)
    return X, y 
    

def resampling_ROS(X, y):
    """
    Balances class distribution using Random Over Sampling (ROS) if the 
    macro Imbalance Ratio (IR) is greater than 1.

    Parameters:
    -----------
    X : numpy.ndarray
        Feature matrix.
    y : numpy.ndarray
        Class labels.

    Returns:
    --------
    tuple (numpy.ndarray, numpy.ndarray)
        Feature matrix and labels after applying over-sampling.
    """
    class_counts = Counter(y)
    max_count = max(class_counts.values())
    min_count = min(class_counts.values())
    ir = max_count / min_count if min_count > 0 else 0

    if ir > 1:
        sampler = RandomOverSampler(random_state=None)
        return sampler.fit_resample(X, y)
    return X, y


def compute_fdr_OVO(X, y):
    """
    Computes the median Fisher's Discriminant Ratio (FDR) using a One-vs-One (OVO) 
    approach across all pairwise class combinations to evaluate feature separability.

    Parameters:
    -----------
    X : numpy.ndarray
        Feature matrix.
    y : numpy.ndarray
        Class labels.

    Returns:
    --------
    float
        The median FDR score calculated across all features and class pairs.
    """
    classes = np.unique(y)
    n_features = X.shape[1]
    fdr_features = []

    for i in range(n_features):
        fdr_pairwise = []
        for c1, c2 in combinations(classes, 2):
            mask = (y == c1) | (y == c2)
            X_pair = X[mask]
            y_pair = y[mask]

            f1 = X_pair[y_pair == c1, i]
            f2 = X_pair[y_pair == c2, i]

            mu1, mu2 = np.mean(f1), np.mean(f2)
            var1, var2 = np.var(f1), np.var(f2)

            denom = var1 + var2
            fdr = 0 if denom == 0 else (mu1 - mu2) ** 2 / denom
            fdr_pairwise.append(fdr)

        fdr_features.append(np.mean(fdr_pairwise))

    return np.median(fdr_features)


def determine_resampling_method(X, y):
    """
    Determines the optimal data resampling strategy (RUS or ROS) and configures 
    tree structure properties based on the average FDR score of the training data.

    Parameters:
    -----------
    X : numpy.ndarray
        Feature matrix of the training data.
    y : numpy.ndarray
        Class labels of the training data.

    Returns:
    --------
    tuple (function, float, float/str, float)
        Selected resampling function, tree depth ratio, feature ratio, and the average FDR score.
    """
    avg_fdr = compute_fdr_OVO(X, y)
    alpha = 1.0
    
    if avg_fdr < alpha:
        depth_ratio = 1.5
        feature_ratio = 'sqrt'
        return resampling_RUS, depth_ratio, feature_ratio, avg_fdr
    else:
        depth_ratio = 2.0
        feature_ratio = 1.0
        return resampling_ROS, depth_ratio, feature_ratio, avg_fdr


def majority_voting(models, X):
    """
    Aggregates prediction decisions from all trained base classifiers 
    using a Hard Majority Voting scheme.

    Parameters:
    -----------
    models : list
        Collection of trained Decision Tree models.
    X : numpy.ndarray
        Feature matrix of the test data.

    Returns:
    --------
    tuple (numpy.ndarray, numpy.ndarray)
        Final predicted class labels and the averaged prediction probability matrix.
    """
    n_classes = len(models[0].classes_)
    n_samples = X.shape[0]
    vote_counts = np.zeros((n_samples, n_classes))

    for model in models:
        preds = model.predict(X)
        for j in range(n_samples):
            vote_counts[j, preds[j]] += 1

    final_predictions = np.argmax(vote_counts, axis=1)
    averaged_probas = vote_counts / len(models)
    return final_predictions, averaged_probas


def compute_q_statistic(models, X_test, y_test):
    """
    Calculates the average pairwise Q-statistic among ensemble classifiers 
    to measure the diversity level of the ensemble model.

    Parameters:
    -----------
    models : list
        Collection of trained models within the ensemble.
    X_test : numpy.ndarray
        Feature matrix of the test data.
    y_test : numpy.ndarray
        Actual true labels of the test data.

    Returns:
    --------
    float
        Average pairwise Q-statistic score.
    """
    pairwise_q = []
    predictions = [model.predict(X_test) for model in models]
    n_models = len(predictions)

    for i in range(n_models):
        for j in range(i + 1, n_models):
            pred_i = predictions[i]
            pred_j = predictions[j]

            n11 = np.sum((pred_i == y_test) & (pred_j == y_test))
            n00 = np.sum((pred_i != y_test) & (pred_j != y_test))
            n10 = np.sum((pred_i == y_test) & (pred_j != y_test))
            n01 = np.sum((pred_i != y_test) & (pred_j == y_test))

            denominator = (n11 * n00) + (n10 * n01)
            q = 0 if denominator == 0 else ((n11 * n00) - (n10 * n01)) / denominator
            pairwise_q.append(q)

    return np.mean(pairwise_q)


def compute_individual_gmean(models, X_test, y_test):
    """
    Calculates the mean Geometric Mean (G-Mean) score of individual 
    base classifiers prior to ensemble aggregation.

    Parameters:
    -----------
    models : list
        Collection of base models.
    X_test : numpy.ndarray
        Feature matrix of the test data.
    y_test : numpy.ndarray
        Actual true labels of the test data.

    Returns:
    --------
    float
        Average individual G-Mean score.
    """
    gmeans = []
    n_classes = len(np.unique(y_test))

    for model in models:
        pred = model.predict(X_test)
        cm = confusion_matrix(y_test, pred, labels=np.arange(n_classes))

        with np.errstate(divide='ignore', invalid='ignore'):
            recall_per_class = np.diag(cm) / np.sum(cm, axis=1)
            recall_per_class = np.nan_to_num(recall_per_class, nan=0.0)

        gmean = np.prod(recall_per_class) ** (1 / n_classes) if np.all(recall_per_class > 0) else 0.0
        gmeans.append(gmean)
        
    return np.mean(gmeans)


def compute_individual_avacc(models, X_test, y_test):
    """
    Calculates the mean Average Accuracy (AvAcc) score of individual 
    base classifiers prior to ensemble aggregation.

    Parameters:
    -----------
    models : list
        Collection of base models.
    X_test : numpy.ndarray
        Feature matrix of the test data.
    y_test : numpy.ndarray
        Actual true labels of the test data.

    Returns:
    --------
    float
        Average individual AvAcc score.
    """
    avaccs = []
    n_classes = len(np.unique(y_test))

    for model in models:
        pred = model.predict(X_test)
        cm = confusion_matrix(y_test, pred, labels=np.arange(n_classes))

        with np.errstate(divide='ignore', invalid='ignore'):
            recall_per_class = np.diag(cm) / np.sum(cm, axis=1)
            recall_per_class = np.nan_to_num(recall_per_class, nan=0.0)

        avaccs.append(np.mean(recall_per_class))
        
    return np.mean(avaccs)


# ==========================================
# MAIN CONFIGURATION & EXPERIMENT PIPELINE
# ==========================================

# Target dataset files for evaluation (5-fold cross-validation scheme)
list_datasets = [
    'winequality-red.csv', 'yeast.csv', 'glass.csv', 'ecoli 5-fold.csv',
    'dermatology.csv', 'solar-flare.csv', 'automobile 5-fold.csv',
    'contraceptive.csv', 'balance-scale.csv', 'led7digit.csv',
    'lymphography 5-fold.csv', 'hayes-roth.csv', 'cleveland.csv',
    'new-thyroid.csv', 'page-blocks.csv', 'wine.csv',
    'thyroid.csv', 'zoo.csv', 'car.csv', 'shuttle 5-fold.csv'
]

results = []
n_repeats = 10
n_folds = 5
n_estimators = 100

# Collection of random seeds to ensure experiment reproducibility across 10 repetitions
list_seed = [123, 1000, 14, 0, 65, 456, 321, 11, 56, 100]

for dataset in list_datasets:
    try:
        df = pd.read_csv(dataset)
    except FileNotFoundError:
        print(f"⚠️ Dataset {dataset} not found. Skipping.")
        continue

    # Separate features (X) and actual class labels (y)
    X = df.iloc[:, :-1].values  
    y = df.iloc[:, -1].values   

    label_encoder = LabelEncoder()
    y_encoded = label_encoder.fit_transform(y)

    n_classes = len(np.unique(y_encoded))
    n_features = X.shape[1]

    avacc_list, mgm_list, mauc_list = [], [], []
    diversity_list, base_gmean_list, base_avacc_list = [], [], []
    total_train_time_list, avg_pred_time_list = [], []
        
    idx_seed = 0
    oversample_count = 0
    undersample_count = 0
        
    for _ in range(n_repeats):
        skf = StratifiedKFold(n_splits=n_folds, shuffle=True, random_state=list_seed[idx_seed])
        idx_seed += 1

        avacc_scores, mgm_scores, mauc_scores = [], [], []
        total_train_time_fold, avg_pred_time_fold = [], []
        
        for train_index, test_index in skf.split(X, y_encoded):         
            start_time = time.perf_counter()
            
            X_train, X_test = X[train_index], X[test_index]
            y_train, y_test = y_encoded[train_index], y_encoded[test_index]

            # Select resampling strategy based on training data characteristics (FDR)
            resample_fn, depth_ratio, feature_ratio, avg_fdr = determine_resampling_method(X_train, y_train)
            
            if resample_fn == resampling_RUS:
                undersample_count += 1
            else:
                oversample_count += 1
            
            majority, minority = get_major_minor_classes(y_train)
            models = []

            # Build a collection of base classifiers (Ensemble Model)
            for subset_num in range(n_estimators):
                X_bootstrap, y_bootstrap = custom_bootstrap(X_train, y_train, majority, minority)
                X_resampled, y_resampled = resample_fn(X_bootstrap, y_bootstrap)
                
                # Configuration for structural diversification of Decision Trees
                if subset_num < n_estimators * 0.5:
                    tree = DecisionTreeClassifier(max_features='sqrt', max_depth=int(depth_ratio * n_features))
                else:
                    tree = DecisionTreeClassifier(max_depth=int(depth_ratio * n_features))
                
                tree.fit(X_resampled, y_resampled)
                models.append(tree)

            end_time = time.perf_counter()
            total_train_time = end_time - start_time
                
            # Inference / Model Testing Phase
            start_time_pred = time.perf_counter()
            y_pred, averaged_probas = majority_voting(models, X_test)
            end_time_pred = time.perf_counter()
            
            avg_pred_time = (end_time_pred - start_time_pred) / len(y_test)
            
            total_train_time_fold.append(total_train_time)
            avg_pred_time_fold.append(avg_pred_time)
            
            # Performance Evaluation across Combined Metrics
            avacc, mgm, mauc = calculate_metrics(y_test, y_pred, averaged_probas, n_classes)
            q_stat = compute_q_statistic(models, X_test, y_test)
            base_gmean = compute_individual_gmean(models, X_test, y_test)
            base_avacc = compute_individual_avacc(models, X_test, y_test)

            diversity_list.append(q_stat)
            base_gmean_list.append(base_gmean)
            base_avacc_list.append(base_avacc)
            avacc_scores.append(avacc)
            mgm_scores.append(mgm)
            mauc_scores.append(mauc)

        total_train_time_list.append(np.mean(total_train_time_fold))
        avg_pred_time_list.append(np.mean(avg_pred_time_fold))
        avacc_list.append(np.mean(avacc_scores))
        mgm_list.append(np.mean(mgm_scores))
        mauc_list.append(np.mean(mauc_scores))

    # Calculate final statistical values (Mean & Standard Deviation)
    final_avg_train_time = np.mean(total_train_time_list)
    final_avg_pred_time = np.mean(avg_pred_time_list)
    
    avacc_mean, avacc_std = np.mean(avacc_list), np.std(avacc_list)
    gmean_mean, gmean_std = np.mean(mgm_list), np.std(mgm_list)
    mauc_mean, mauc_std = np.mean(mauc_list), np.std(mauc_list)
            
    results.append({
        "Dataset": dataset,
        "AvAcc_mean": round(avacc_mean, 4),
        "AvAcc_std": round(avacc_std, 4),
        "GMean_mean": round(gmean_mean, 4),
        "GMean_std": round(gmean_std, 4),
        "MAUC_mean": round(mauc_mean, 4),
        "MAUC_std": round(mauc_std, 4),
        "Train_time_mean": round(final_avg_train_time, 6),
        "Pred_time_mean": round(final_avg_pred_time, 6),
        "Base_GMean": round(np.mean(base_gmean_list), 4),
        "Base_AvAcc": round(np.mean(base_avacc_list), 4),
        "Q_Statistic": round(np.mean(diversity_list), 4)
    })
    
    # Print performance summary log per dataset to the console
    print(f"\n✅ {dataset} | "
          f"Base_GMean: {results[-1]['Base_GMean']} | "
          f"Base_AvAcc: {results[-1]['Base_AvAcc']} | "
          f"Q-Stat: {results[-1]['Q_Statistic']} | "
          f"AvAcc: {results[-1]['AvAcc_mean']} ± {results[-1]['AvAcc_std']} | "
          f"G-Mean: {results[-1]['GMean_mean']} ± {results[-1]['GMean_std']} | "
          f"MAUC: {results[-1]['MAUC_mean']} ± {results[-1]['MAUC_std']} | "
          f"Train_time: {results[-1]['Train_time_mean']} | "
          f"Pred_time: {results[-1]['Pred_time_mean']}")
    
    avg_oversample_count = oversample_count / (n_repeats * n_folds)
    avg_undersample_count = undersample_count / (n_repeats * n_folds)
    print(f"Oversampling: {avg_oversample_count}, Undersampling: {avg_undersample_count}")
    
# Save all evaluation results in a tabular CSV format
pd.DataFrame(results).to_csv("FDR-Bagging_results.csv", index=False)
print("\n🎉 Execution completed successfully. Summary saved to 'Before_Constraint_gmean.csv'.")
